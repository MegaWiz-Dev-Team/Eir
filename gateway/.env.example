# Eir Gateway Configuration
OPENEMR_URL=http://localhost:80
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9090
AUTH_SECRET=your-secret-token-here
AUTH_ENABLED=false
# Secret shared with OpenEMR (same value as EIR_GATEWAY_SECRET on the Eir container).
# >= 32 chars, e.g. `openssl rand -hex 32`. Unset = OpenEMR never trusts the gateway.
EIR_GATEWAY_SECRET=
LOG_LEVEL=info
RATE_LIMIT_RPS=100
CACHE_TTL_SECS=60
TENANT_ID=default
